# Database (SQLite)
DATABASE_URL="file:./dev.db"

# API & Dashboard configuration
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# LLM Providers (OpenAI, Anthropic, Gemini)
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Image & Video generation credentials (Replicate, Midjourney API, etc.)
REPLICATE_API_TOKEN="your-replicate-token"
STABILITY_API_KEY="your-stability-api-key"

# Storage Settings
STORAGE_PATH="./storage"
S3_BUCKET_NAME="burger-ai-studio-assets"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# n8n webhook urls for agent orchestration triggers
N8N_ORCHESTRATOR_WEBHOOK_URL="http://localhost:5678/webhook/orchestrator"
